# URL base da API Spring Boot, incluindo o prefixo /api.
BACKEND_API_URL=http://backend:8080/api
# true usa a API simulada em memória enquanto o backend não está pronto.
# Tokens aceitos pela simulação: token-tutor-1 e token-tutor-2.
BACKEND_MOCK=false

# LangChain usa o Ollama do serviço "ollama" do Compose. O modelo é baixado
# automaticamente na primeira subida (serviço ollama-init).
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=llama3.2
# Nome do serviço e porta interna do container (não a porta da máquina).
OLLAMA_BASE_URL=http://ollama:11434

PORT=8001

HORARIO_FUNCIONAMENTO=de segunda a sábado, das 8h às 18h, com horários a cada 30 minutos
CANAL_ATENDIMENTO_HUMANO=procure a recepção do PetCare Hub
TIMEZONE=America/Sao_Paulo

# Limites de tempo em segundos (RNF11).
BACKEND_TIMEOUT_SECONDS=3
LLM_TIMEOUT_SECONDS=15
TEMPO_MAXIMO_RESPOSTA_SECONDS=20
# false responde só com as mensagens padrão, sem reescrita pelo modelo.
LLM_REDACAO=true
